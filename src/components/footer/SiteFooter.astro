---
/**
 * Site footer — social links, legal links, copyright.
 * All text comes from locale JSON (footer.* namespace).
 */
import { Icon } from 'astro-icon/components';
import { site } from '~/config/site';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { gamesPath, localizePath } from '~/lib/url';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = getUi(locale);
const footer = ui.footer;
const legalLinks: Array<keyof typeof footer> = [
  'about',
  'faq',
  'privacyPolicy',
  'termsOfService',
  'copyright',
  'contact',
];
---

<footer class="mt-20 bg-background">
  <div class="mx-auto max-w-7xl border-t-2 border-foreground px-4 py-8">
    <div class="grid gap-8 md:grid-cols-[1.4fr_.6fr_1fr]">
      {/* Brand */}
      <div>
        <div class="flex items-baseline gap-2">
          <span class="archive-display text-xl">1in8b</span>
          <span class="text-[10px] font-extrabold uppercase tracking-[0.16em] text-muted-foreground"
            >Game Guides</span
          >
        </div>
        <p class="mt-3 max-w-md text-sm text-muted-foreground">
          Discover games, find where to play, and get practical help when you need it.
        </p>
        <p class="mt-3 text-xs">
          <a href={gamesPath(locale)} class="text-foreground/70 transition hover:text-nav"
            >Browse games</a
          >
        </p>
      </div>

      {/* Explore */}
      <div>
        <h2 class="text-xs font-extrabold uppercase tracking-[0.14em] text-nav">Explore</h2>
        <ul class="mt-3 space-y-2">
          <li>
            <a
              href={gamesPath(locale)}
              class="inline-flex items-center gap-2 text-sm text-foreground/80 transition hover:text-nav"
              ><Icon name="lucide:gamepad-2" class="h-4 w-4" />Games</a
            >
          </li>
        </ul>
      </div>

      {/* Legal */}
      <div>
        <h2 class="text-xs font-extrabold uppercase tracking-[0.14em] text-nav">
          {footer.legal ?? 'Legal'}
        </h2>
        <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2">
          {
            legalLinks.map((key) => (
              <li>
                <a
                  href={localizePath(
                    `/${key === 'privacyPolicy' ? 'privacy-policy' : key === 'termsOfService' ? 'terms-of-service' : key}`,
                    locale,
                  )}
                  class="text-sm text-foreground/80 transition hover:text-nav"
                >
                  {footer[key]}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-8 flex flex-col gap-2 border-t border-border pt-5 md:flex-row md:items-center md:justify-between"
    >
      {
        /* Copyright line and the fan-site legal notice are SEPARATE lines —
          a `copyrightText ?? legalNotice` short-circuit left forks (whose
          CLI rewrites copyrightText without the disclaimer) with no notice. */
      }
      {
        footer.copyrightText && (
          <p class="text-xs font-medium text-muted-foreground">{footer.copyrightText}</p>
        )
      }
      {
        site.legalNotice && (
          <p class="max-w-2xl text-xs text-muted-foreground md:text-right">{site.legalNotice}</p>
        )
      }
    </div>
  </div>
</footer>
