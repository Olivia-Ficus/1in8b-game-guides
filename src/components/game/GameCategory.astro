---
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import GameCard from '~/components/game/GameCard.astro';
import { defaultLocale } from '~/i18n/routing';
import { getPublishedGames } from '~/lib/games';
import { GAME_CATEGORIES, gamesInCategory, gameCategoryPath, type GameCategorySlug } from '~/lib/game-categories';
import { gamesPath, gamePath } from '~/lib/url';
import { siteUrl } from '~/config/site';
import { simpleBreadcrumbJsonLd, urlListJsonLd } from '~/lib/seo';

interface Props {
  category: GameCategorySlug;
}
const { category } = Astro.props;
const config = GAME_CATEGORIES.find((item) => item.slug === category)!;
const allGames = (await getPublishedGames()).filter((game) => !game.data.noindex);
const games = gamesInCategory(allGames, category);
const jsonLd = [
  simpleBreadcrumbJsonLd({
    pageLabel: config.title,
    path: gameCategoryPath(category, defaultLocale),
    locale: defaultLocale,
  }),
  ...(games.length
    ? [urlListJsonLd({
        name: config.title,
        items: games.map((game) => ({
          title: game.data.name,
          url: `${siteUrl}${gamePath(game.data.slug, defaultLocale)}`,
        })),
      })]
    : []),
];
---

<LocaleLayout
  locale={defaultLocale}
  title={config.title}
  description={config.description}
  noindex={games.length === 0}
  jsonLd={jsonLd}
>
  <header class="border-b border-border pb-10 pt-5 md:pb-14 md:pt-9">
    <p class="archive-kicker">Browse by type</p>
    <h1 class="mt-4 text-5xl font-black uppercase leading-none tracking-[-.06em] sm:text-6xl lg:text-7xl">
      {config.title}
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">{config.description}</p>
    <a href={gamesPath(defaultLocale)} class="mt-6 inline-block text-sm font-bold text-nav underline">
      View all games
    </a>
  </header>
  <section class="py-10">
    <div class="archive-section-head">
      <h2 class="text-2xl font-black uppercase">Browse Games</h2>
      <span class="text-xs font-bold uppercase tracking-wide text-muted-foreground">
        {games.length} {games.length === 1 ? 'game' : 'games'}
      </span>
    </div>
    {
      games.length ? (
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {games.map((game) => <GameCard game={game} locale={defaultLocale} />)}
        </div>
      ) : (
        <p class="mt-6 text-muted-foreground">No verified games are listed in this category yet.</p>
      )
    }
  </section>
</LocaleLayout>
