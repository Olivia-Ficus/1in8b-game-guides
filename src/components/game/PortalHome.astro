---
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import GameCard from './GameCard.astro';
import GameSearch from './GameSearch.astro';
import { type Locale } from '~/i18n/routing';
import { getPublishedGames, getGameGuides } from '~/lib/games';
import { gamePath, gamesPath } from '~/lib/url';
import { websiteJsonLd, urlListJsonLd } from '~/lib/seo';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const games = await getPublishedGames();
// With a small initial catalog every published fixture is intentionally shown;
// `featured`/`featuredOrder` can narrow and order this list as real games are
// added without changing the component.
const featured = [...games].sort((a, b) => (a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999));
const updates = (await Promise.all(games.map(async (game) => ({ game, guides: await getGameGuides(game.data.slug, locale) })))).flatMap(({ game, guides }) => guides.map((guide) => ({ game, guide }))).sort((a, b) => (b.guide.data.lastModified ?? b.guide.data.date).getTime() - (a.guide.data.lastModified ?? a.guide.data.date).getTime()).slice(0, 4);
const noindex = games.length === 0 || games.every((game) => game.data.noindex);
const jsonLd = [websiteJsonLd(locale), ...(games.length ? [urlListJsonLd({ name: 'Games', items: games.map((game) => ({ title: game.data.name, url: gamePath(game.data.slug, locale) })) })] : [])];
---
<LocaleLayout locale={locale} title="Trending Game Guides & Player Companion" description="Discover games, find where to play, and get practical player help." noindex={noindex} jsonLd={jsonLd}>
  <section class="portal-hero -mx-4 -mt-8 overflow-hidden border-b"><div class="portal-grid absolute inset-0"></div><div class="relative mx-auto max-w-7xl px-4 py-16 md:py-24"><p class="text-sm font-semibold uppercase tracking-[0.18em] text-nav">1in8b Game Guides</p><h1 class="mt-4 max-w-3xl text-4xl font-black tracking-tight md:text-6xl">Find the game. Start playing. Get unstuck.</h1><p class="mt-5 max-w-2xl text-lg text-muted-foreground">Discover game entry points and practical, game-specific answers without digging through a traditional wiki.</p><div class="mt-8 max-w-3xl"><GameSearch games={games} locale={locale} /></div></div></section>
  <section class="section"><div class="flex items-end justify-between gap-4"><div><p class="text-sm font-semibold text-nav">Curated discovery</p><h2 class="mt-1 text-2xl font-black">Featured games</h2></div><a href={gamesPath(locale)} class="text-sm font-semibold text-nav hover:underline">Browse all games <span aria-hidden="true">→</span></a></div>{featured.length ? <><p class="mt-3 text-sm text-muted-foreground">Featured is an editorial label, not a live popularity ranking.</p><div class="mt-6 grid gap-5 md:grid-cols-2">{featured.map((game) => <GameCard game={game} locale={locale} />)}</div></> : <p class="mt-6 text-muted-foreground">Published games will appear here as they are added.</p>}</section>
  <section class="section border-t"><div class="grid gap-10 lg:grid-cols-[1.2fr_.8fr]"><div><p class="text-sm font-semibold text-nav">Browse</p><h2 class="mt-1 text-2xl font-black">Explore the game directory</h2><p class="mt-3 max-w-xl text-muted-foreground">Each game has its own entry point, platforms, official link when verified, and only the help topics that exist for it.</p><a href={gamesPath(locale)} class="btn-primary mt-6">Open game directory <Icon name="lucide:arrow-right" class="ml-2 h-4 w-4" /></a></div><dl class="grid grid-cols-2 gap-3 self-end"><div class="rounded-xl border bg-card p-4"><dt class="text-xs text-muted-foreground">Published games</dt><dd class="mt-1 text-2xl font-black">{games.length}</dd></div><div class="rounded-xl border bg-card p-4"><dt class="text-xs text-muted-foreground">Available guides</dt><dd class="mt-1 text-2xl font-black">{updates.length}</dd></div></dl></div></section>
  <section class="section border-t"><p class="text-sm font-semibold text-nav">Recently updated</p><h2 class="mt-1 text-2xl font-black">Fresh player help</h2>{updates.length ? <div class="mt-6 grid gap-3">{updates.map(({ game, guide }) => <a class="group flex items-center justify-between gap-4 rounded-xl border bg-card p-4 transition hover:border-nav/50" href={`${gamePath(game.data.slug, locale)}${guide.data.topic}/`}><div><p class="text-xs font-semibold text-nav">{game.data.name}</p><h3 class="mt-1 font-bold group-hover:text-nav">{guide.data.title}</h3><p class="mt-1 text-sm text-muted-foreground">Updated {(guide.data.lastModified ?? guide.data.date).toLocaleDateString(locale, { timeZone: 'UTC' })}</p></div><Icon name="lucide:arrow-up-right" class="h-5 w-5 shrink-0 text-muted-foreground" /></a>)}</div> : <p class="mt-5 text-muted-foreground">Game-specific updates will appear here when content is published.</p>}</section>
</LocaleLayout>
<style>.portal-hero{position:relative;background:linear-gradient(135deg,hsl(var(--brand) / .16),transparent 55%),hsl(var(--background))}.portal-grid{opacity:.25;background-image:linear-gradient(hsl(var(--brand) / .22) 1px,transparent 1px),linear-gradient(90deg,hsl(var(--brand) / .22) 1px,transparent 1px);background-size:32px 32px;mask-image:linear-gradient(to bottom,black,transparent)}</style>
