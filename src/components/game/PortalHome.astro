---
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import GameCard from './GameCard.astro';
import AdsterraSlot from '~/components/ads/AdsterraSlot.astro';
import MobileAnchorAd from '~/components/ads/MobileAnchorAd.astro';
import { type Locale } from '~/i18n/routing';
import { getPublishedGames } from '~/lib/games';
import { gamePath, gamesPath } from '~/lib/url';
import { websiteJsonLd, urlListJsonLd } from '~/lib/seo';
import { siteUrl } from '~/config/site';
import { GAME_CATEGORIES, isBrowserGame, gamesListedThisWeek, gameCategoryPath } from '~/lib/game-categories';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const allGames = await getPublishedGames();
// Fixtures remain buildable for route regression tests, but discovery pages
// only present games intended for players.
const games = allGames.filter((game) => !game.data.noindex);
const updates = [...games]
  .sort(
    (a, b) =>
      b.data.updatedAt.getTime() - a.data.updatedAt.getTime() ||
      a.data.name.localeCompare(b.data.name),
  )
  .slice(0, 4);
// Featured is a deliberate, browser-playable editorial pick—not the latest guide edit.
const browserGames = games.filter(isBrowserGame);
const featuredGame = browserGames.find((game) => game.data.featured) ?? browserGames[0];
const newThisWeek = gamesListedThisWeek(games);
const noindex = games.length === 0;
const drinkGuide = games.find((game) => game.data.slug === 'drink-the-ocean');
const jsonLd = [
  websiteJsonLd(locale),
  ...(games.length
    ? [
        urlListJsonLd({
          name: 'Games',
          items: games.map((game) => ({
            title: game.data.name,
            url: `${siteUrl}${gamePath(game.data.slug, locale)}`,
          })),
        }),
      ]
    : []),
];
---

<LocaleLayout
  locale={locale}
  title="Browser Games: New & Trending to Play Free | 1in8b"
  titleSuffix=""
  description="Explore free browser games with no download needed. Discover new games every week, official play links, and player guides for handpicked indie titles."
  noindex={noindex}
  jsonLd={jsonLd}
>
  <section class="py-12 md:py-16">
    <div class="archive-section-head">
      <div>
        <p class="archive-kicker">Featured this week</p><h1 class="mt-1 text-3xl font-black uppercase">
          Browser Games: New &amp; Trending
        </h1>
      </div><a
        href={gamesPath(locale)}
        class="hidden text-xs font-extrabold uppercase tracking-[.1em] text-nav hover:underline sm:inline"
        >All games <span aria-hidden="true">→</span></a
      >
    </div>
    {
      featuredGame ? (
        <article class="featured-game mt-6 grid border border-border bg-card lg:grid-cols-[1.18fr_.82fr]">
          <a
            href={gamePath(featuredGame.data.slug, locale)}
            class="featured-art block overflow-hidden border-b border-border lg:border-b-0 lg:border-r"
          >
            <img
              src={featuredGame.data.cover}
              alt={`${featuredGame.data.name} gameplay`}
              class="aspect-[16/9] h-full min-h-64 w-full object-cover lg:aspect-auto"
              loading="eager"
            />
          </a>
          <div class="flex flex-col justify-center p-6 md:p-9">
            <p class="archive-kicker">Play in your browser</p>
            <h2 class="mt-3 text-4xl font-black md:text-5xl">{featuredGame.data.name}</h2>
            <p class="mt-3 flex flex-wrap items-center gap-2 text-sm font-bold text-muted-foreground">
              <Icon name="lucide:gamepad-2" class="h-4 w-4" />
              {featuredGame.data.genre}
              {featuredGame.data.genre && featuredGame.data.platforms.length > 0 && (
                <span aria-hidden="true">·</span>
              )}
              {featuredGame.data.platforms.join(' · ')}
            </p>
            <p class="mt-6 text-base leading-relaxed text-muted-foreground">
              {featuredGame.data.description}
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              <a class="btn-primary" href={gamePath(featuredGame.data.slug, locale)}>
                Explore Game <Icon name="lucide:arrow-right" class="ml-2 h-4 w-4" />
              </a>
              {featuredGame.data.officialUrl && (
                <a
                  class="btn-outline"
                  href={featuredGame.data.officialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Play Game <Icon name="lucide:external-link" class="ml-2 h-4 w-4" />
                </a>
              )}
            </div>
            <p class="mt-3 text-xs text-muted-foreground">Play Game opens the official site.</p>
          </div>
        </article>
      ) : (
        <p class="mt-6 border-l-2 border-nav pl-4 text-muted-foreground">
          Featured games will appear here when they are published.
        </p>
      )
    }
  </section>


  <section class="archive-rule py-10 md:py-12" aria-label="About our browser games directory">
    <div class="max-w-3xl space-y-4 text-base leading-relaxed text-muted-foreground">
      <p>1in8b is a small, handpicked directory for players who want to find browser games they can actually open and play, without downloading a client first. We focus on recent releases, surprising independent projects, and games people are actively sharing. Every listing links to the game's official play page rather than asking you to sign up here.</p>
      <p>Start with our <a href={gameCategoryPath('browser', locale)} class="font-semibold text-nav underline">browser games</a> if you want something you can launch right away. A game card tells you which devices it supports, while the linked player guide explains basic controls, game modes, progression, and the questions that come up during play. We check potential new additions every week and update a guide when its instructions or game version change. The New this week section shows games first added to this directory in the past seven days, not every game receiving a patch.</p>
      <p>This is not an unfiltered collection of every game on the internet, and a Steam-only release is not a browser game. We occasionally keep downloadable indie titles in the wider games catalog for their guides, but never feature them as instant browser play.</p>
    </div>
    <nav class="mt-8 flex flex-wrap gap-2" aria-label="Browse game categories">
      {GAME_CATEGORIES.map((category) => (
        <a
          href={gameCategoryPath(category.slug, locale)}
          class="rounded-sm border border-border bg-card px-4 py-2 text-sm font-bold text-foreground transition hover:border-nav hover:text-nav"
        >
          {category.label}
        </a>
      ))}
    </nav>
  </section>

  <section class="archive-rule py-10 md:py-12">
    <div class="archive-section-head">
      <h2 class="text-3xl font-black uppercase">Browse Games</h2><a
        href={gamesPath(locale)}
        class="text-xs font-extrabold uppercase tracking-[.1em] text-nav hover:underline"
        >View all games <span aria-hidden="true">→</span></a
      >
    </div>
    {drinkGuide && (
      <p class="mt-3 text-sm text-muted-foreground">
        Playing the Mana version? <a class="font-semibold text-nav underline" href={gamePath(drinkGuide.data.slug, locale)}>Drink the Ocean game guide</a>
      </p>
    )}
    {
      games.length ? (
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {games.map((game) => (
            <GameCard game={game} locale={locale} />
          ))}
        </div>
      ) : (
        <p class="mt-6 text-muted-foreground">
          Published games will appear here as they are added.
        </p>
      )
    }
  </section>

  <section class="archive-rule py-10 md:py-12">
    <div class="archive-section-head">
      <h2 class="text-3xl font-black uppercase">New this week</h2>
      <a href={gameCategoryPath('new', locale)} class="text-xs font-extrabold uppercase tracking-[.1em] text-nav hover:underline">
        All new games <span aria-hidden="true">→</span>
      </a>
    </div>
    {
      newThisWeek.length ? (
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {newThisWeek.map((game) => <GameCard game={game} locale={locale} />)}
        </div>
      ) : (
        <p class="mt-6 text-sm text-muted-foreground">
          No new listings in the past seven days. <a href={gamesPath(locale)} class="text-nav underline">See all games</a>.
        </p>
      )
    }
  </section>

  {/* Ad units follow the game discovery content; never interrupt the first screen. */}
  <aside aria-label="Advertisements" class="archive-rule flex flex-wrap items-center justify-center gap-x-12 py-6">
    <AdsterraSlot name="sidebar-300x250" width={300} height={250} />
    <AdsterraSlot name="sidebar-160x300" width={160} height={300} hideOnMobile />
  </aside>
  <MobileAnchorAd />

  <section class="archive-rule py-10 md:py-12">
    <div class="archive-section-head">
      <h2 class="text-3xl font-black uppercase">Recently Updated</h2>
    </div>
    {
      updates.length ? (
        <div class="mt-3 divide-y divide-border border-b border-border">
          {updates.map((game) => (
            <a
              class="update-row grid items-center gap-3 py-4 sm:grid-cols-[4rem_1fr_auto]"
              href={gamePath(game.data.slug, locale)}
            >
              <img
                src={game.data.cover}
                alt=""
                class="h-12 w-16 border border-border object-cover"
                loading="lazy"
              />
              <div>
                <h3 class="font-black">{game.data.name}</h3>
                <p class="mt-0.5 text-sm text-muted-foreground">
                  Controls, game modes, tips, and common questions
                </p>
              </div>
              <time
                class="text-xs font-bold uppercase tracking-wide text-muted-foreground"
                datetime={game.data.updatedAt.toISOString()}
              >
                {game.data.updatedAt.toLocaleDateString(locale, {
                  month: 'short',
                  day: 'numeric',
                  timeZone: 'UTC',
                })}
              </time>
            </a>
          ))}
        </div>
      ) : (
        <p class="mt-6 text-muted-foreground">
          Updates will appear here when game content is published.
        </p>
      )
    }
  </section>
</LocaleLayout>

<style>
  .featured-game,
  .featured-art img {
    border-radius: 2px;
  }
  .featured-art img {
    transition: filter 0.18s ease;
  }
  .featured-art:hover img {
    filter: brightness(0.96);
  }
  .update-row {
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .update-row:hover {
    color: hsl(var(--brand-text));
    background: hsl(var(--muted) / 0.45);
  }
</style>
