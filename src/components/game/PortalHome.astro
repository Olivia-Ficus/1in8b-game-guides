---
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import GameCard from './GameCard.astro';
import GameSearch from './GameSearch.astro';
import { type Locale } from '~/i18n/routing';
import { getPublishedGames } from '~/lib/games';
import { gamePath, gamesPath } from '~/lib/url';
import { websiteJsonLd, urlListJsonLd } from '~/lib/seo';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const allGames = await getPublishedGames();
// Fixtures remain buildable for route regression tests, but discovery pages
// only present games intended for players.
const games = allGames.filter((game) => !game.data.noindex);
const featured = [...games]
  .filter((game) => game.data.featured)
  .sort((a, b) => (a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999));
const featuredGame = featured[0];
const updates = [...games]
  .sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime())
  .slice(0, 4);
const noindex = games.length === 0;
const jsonLd = [
  websiteJsonLd(locale),
  ...(games.length
    ? [
        urlListJsonLd({
          name: 'Games',
          items: games.map((game) => ({
            title: game.data.name,
            url: gamePath(game.data.slug, locale),
          })),
        }),
      ]
    : []),
];
---

<LocaleLayout
  locale={locale}
  title="Discover Games"
  description="Discover trending games, find where to play, and get practical guides to help you play better."
  noindex={noindex}
  jsonLd={jsonLd}
>
  <header class="archive-intro border-b border-border pb-10 pt-5 md:pb-14 md:pt-9">
    <p class="archive-kicker">Games &amp; player guides</p>
    <h1
      class="mt-4 max-w-5xl text-5xl font-black uppercase leading-[.92] tracking-[-.065em] sm:text-6xl lg:text-8xl"
    >
      Discover Games
    </h1>
    <div class="mt-6 grid gap-6 md:grid-cols-[1fr_minmax(18rem,32rem)] md:items-end">
      <p class="max-w-2xl text-lg leading-relaxed text-muted-foreground">
        Find something new to play, explore game modes, and get help when you need it.
      </p>
      <GameSearch games={games} locale={locale} />
    </div>
  </header>

  <section class="py-12 md:py-16">
    <div class="archive-section-head">
      <div>
        <p class="archive-kicker">Recommended now</p><h2 class="mt-1 text-3xl font-black uppercase">
          Featured Game
        </h2>
      </div><a
        href={gamesPath(locale)}
        class="hidden text-xs font-extrabold uppercase tracking-[.1em] text-nav hover:underline sm:inline"
        >All games <span aria-hidden="true">→</span></a
      >
    </div>
    {
      featuredGame ? (
        <article class="featured-game mt-6 grid border border-border bg-card lg:grid-cols-[1.18fr_.82fr]">
          <a
            href={gamePath(featuredGame.data.slug, locale)}
            class="featured-art block overflow-hidden border-b border-border lg:border-b-0 lg:border-r"
          >
            <img
              src={featuredGame.data.cover}
              alt={`${featuredGame.data.name} gameplay`}
              class="h-full min-h-64 w-full object-cover"
              loading="eager"
            />
          </a>
          <div class="flex flex-col justify-center p-6 md:p-9">
            <p class="archive-kicker">Featured Game</p>
            <h3 class="mt-3 text-4xl font-black md:text-5xl">{featuredGame.data.name}</h3>
            <p class="mt-3 flex flex-wrap items-center gap-2 text-sm font-bold text-muted-foreground">
              <Icon name="lucide:gamepad-2" class="h-4 w-4" />
              {featuredGame.data.genre}
              {featuredGame.data.genre && featuredGame.data.platforms.length > 0 && (
                <span aria-hidden="true">·</span>
              )}
              {featuredGame.data.platforms.join(' · ')}
            </p>
            <p class="mt-6 text-base leading-relaxed text-muted-foreground">
              {featuredGame.data.description}
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              <a class="btn-primary" href={gamePath(featuredGame.data.slug, locale)}>
                Explore Game <Icon name="lucide:arrow-right" class="ml-2 h-4 w-4" />
              </a>
              {featuredGame.data.officialUrl && (
                <a
                  class="btn-outline"
                  href={featuredGame.data.officialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Play Game <Icon name="lucide:external-link" class="ml-2 h-4 w-4" />
                </a>
              )}
            </div>
            <p class="mt-3 text-xs text-muted-foreground">Play Game opens the official site.</p>
          </div>
        </article>
      ) : (
        <p class="mt-6 border-l-2 border-nav pl-4 text-muted-foreground">
          Featured games will appear here when they are published.
        </p>
      )
    }
  </section>

  <section class="archive-rule py-10 md:py-12">
    <div class="archive-section-head">
      <h2 class="text-3xl font-black uppercase">Browse Games</h2><a
        href={gamesPath(locale)}
        class="text-xs font-extrabold uppercase tracking-[.1em] text-nav hover:underline"
        >View all games <span aria-hidden="true">→</span></a
      >
    </div>
    {
      games.length ? (
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {games.map((game) => (
            <GameCard game={game} locale={locale} />
          ))}
        </div>
      ) : (
        <p class="mt-6 text-muted-foreground">
          Published games will appear here as they are added.
        </p>
      )
    }
  </section>

  <section class="archive-rule py-10 md:py-12">
    <div class="archive-section-head">
      <h2 class="text-3xl font-black uppercase">Recently Updated</h2>
    </div>
    {
      updates.length ? (
        <div class="mt-3 divide-y divide-border border-b border-border">
          {updates.map((game) => (
            <a
              class="update-row grid items-center gap-3 py-4 sm:grid-cols-[4rem_1fr_auto]"
              href={gamePath(game.data.slug, locale)}
            >
              <img
                src={game.data.cover}
                alt=""
                class="h-12 w-16 border border-border object-cover"
                loading="lazy"
              />
              <div>
                <h3 class="font-black">{game.data.name}</h3>
                <p class="mt-0.5 text-sm text-muted-foreground">
                  Controls, game modes, tips, and common questions
                </p>
              </div>
              <time
                class="text-xs font-bold uppercase tracking-wide text-muted-foreground"
                datetime={game.data.updatedAt.toISOString()}
              >
                {game.data.updatedAt.toLocaleDateString(locale, {
                  month: 'short',
                  day: 'numeric',
                  timeZone: 'UTC',
                })}
              </time>
            </a>
          ))}
        </div>
      ) : (
        <p class="mt-6 text-muted-foreground">
          Updates will appear here when game content is published.
        </p>
      )
    }
  </section>
</LocaleLayout>

<style>
  .featured-game,
  .featured-art img {
    border-radius: 2px;
  }
  .featured-art img {
    transition: filter 0.18s ease;
  }
  .featured-art:hover img {
    filter: brightness(0.96);
  }
  .update-row {
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .update-row:hover {
    color: hsl(var(--brand-text));
    background: hsl(var(--muted) / 0.45);
  }
</style>
