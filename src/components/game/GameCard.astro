---
import { Icon } from 'astro-icon/components';
import { type GameEntry } from '~/lib/games';
import { gamePath } from '~/lib/url';
import { type Locale } from '~/i18n/routing';
interface Props { game: GameEntry; locale: Locale; compact?: boolean; }
const { game, locale, compact = false } = Astro.props;
const initial = game.data.name.slice(0, 1).toUpperCase();
---
<a href={gamePath(game.data.slug, locale)} class:list={['group game-card block overflow-hidden', compact && 'game-card-compact']} data-game-card data-game-name={game.data.name.toLowerCase()} data-game-platforms={game.data.platforms.join(' ').toLowerCase()}>
  <div class="game-card-art relative flex aspect-[16/8] items-end overflow-hidden p-4">
    {game.data.cover ? <img src={game.data.cover} alt={`${game.data.name} cover`} class="absolute inset-0 h-full w-full object-cover" loading="lazy" /> : <><span class="game-grid absolute inset-0"></span><span class="relative text-5xl font-black tracking-tighter text-white/90">{initial}</span></>}
    {game.data.featured && <span class="absolute right-3 top-3 rounded-full bg-background/90 px-2.5 py-1 text-xs font-semibold text-foreground">Featured</span>}
  </div>
  <div class="p-4"><h2 class="font-bold group-hover:text-nav">{game.data.name}</h2><p class="mt-1 line-clamp-2 text-sm text-muted-foreground">{game.data.description}</p>{game.data.platforms.length > 0 && <p class="mt-3 flex items-center gap-1.5 text-xs text-muted-foreground"><Icon name="lucide:gamepad-2" class="h-3.5 w-3.5" />{game.data.platforms.join(' · ')}</p>}</div>
</a>

<style>
  .game-card { border: 1px solid hsl(var(--border)); border-radius: .9rem; background: hsl(var(--card)); transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease; }
  .game-card[hidden] { display: none !important; }
  .game-card:hover { transform: translateY(-2px); border-color: hsl(var(--brand) / .6); box-shadow: 0 14px 32px -20px hsl(var(--foreground) / .45); }
  .game-card-art { background: linear-gradient(135deg, hsl(var(--brand-h) var(--brand-s) 36%), hsl(247 70% 34%)); }
  .game-grid { opacity: .28; background-image: linear-gradient(hsl(0 0% 100% / .35) 1px, transparent 1px), linear-gradient(90deg, hsl(0 0% 100% / .35) 1px, transparent 1px); background-size: 16px 16px; mask-image: linear-gradient(to bottom, black, transparent); }
</style>
