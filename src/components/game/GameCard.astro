---
import { Icon } from 'astro-icon/components';
import { type GameEntry } from '~/lib/games';
import { gamePath } from '~/lib/url';
import { type Locale } from '~/i18n/routing';
interface Props {
  game: GameEntry;
  locale: Locale;
  compact?: boolean;
}
const { game, locale, compact = false } = Astro.props;
const initial = game.data.name.slice(0, 1).toUpperCase();
---

<a
  href={gamePath(game.data.slug, locale)}
  class:list={['game-card group block overflow-hidden', compact && 'game-card-compact']}
  data-game-card
  data-game-name={game.data.name.toLowerCase()}
  data-game-platforms={game.data.platforms.join(' ').toLowerCase()}
>
  <div class="game-card-art relative flex aspect-[4/3] items-end overflow-hidden">
    {
      game.data.cover ? (
        <img
          src={game.data.cover}
          alt={`${game.data.name} cover`}
          class="absolute inset-0 h-full w-full object-cover"
          loading="lazy"
        />
      ) : (
        <>
          <>
            <span class="game-grid absolute inset-0" />
            <span class="relative p-5 text-5xl font-black tracking-tighter text-white/90">
              {initial}
            </span>
          </>
        </>
      )
    }
  </div>
  <div class="border-t border-border p-4">
    <div class="flex items-start justify-between gap-3">
      <h2 class="text-lg font-black group-hover:text-nav">{game.data.name}</h2><Icon
        name="lucide:arrow-up-right"
        class="mt-1 h-4 w-4 shrink-0 text-nav"
      />
    </div>
    <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">{game.data.description}</p>
    <p
      class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-semibold text-muted-foreground"
    >
      <Icon name="lucide:gamepad-2" class="h-3.5 w-3.5" />{
        game.data.genre && <span>{game.data.genre}</span>
      }{game.data.genre && game.data.platforms.length > 0 && <span aria-hidden="true">·</span>}{
        game.data.platforms.length > 0 && <span>{game.data.platforms.join(' · ')}</span>
      }
    </p>
  </div>
</a>

<style>
  .game-card {
    border: 1px solid hsl(var(--border));
    border-radius: 2px;
    background: hsl(var(--card));
    transition:
      border-color 0.18s ease,
      background-color 0.18s ease;
  }
  .game-card[hidden] {
    display: none !important;
  }
  .game-card:hover {
    border-color: hsl(var(--brand-text));
    background: hsl(var(--muted));
  }
  .game-card-art {
    background: hsl(var(--foreground));
  }
  .game-grid {
    opacity: 0.28;
    background-image:
      linear-gradient(hsl(0 0% 100% / 0.35) 1px, transparent 1px),
      linear-gradient(90deg, hsl(0 0% 100% / 0.35) 1px, transparent 1px);
    background-size: 16px 16px;
    mask-image: linear-gradient(to bottom, black, transparent);
  }
</style>
