<div class="control-guide not-prose">
  <section class="control-card">
    <p class="control-label">Desktop · keyboard</p>
    <div class="keyboard" role="img" aria-label="Keyboard layout highlighting W, A, S and D">
      <div><kbd>W</kbd></div>
      <div><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd></div>
      <div><kbd class="wide">Space</kbd></div>
    </div>
  </section>
  <section class="control-card mobile-card">
    <p class="control-label">Mobile · touch</p>
    <div class="phone" role="img" aria-label="Phone diagram showing touch and drag steering"><span class="road"></span><span class="car"></span><span class="finger">☝</span></div>
    <p>Touch and drag left or right to steer. The car accelerates automatically.</p>
  </section>
</div>

<style>
  .control-guide{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:1.5rem 0}.control-card{border:1px solid hsl(var(--border));border-radius:.85rem;background:hsl(var(--card));padding:1.25rem}.control-label{margin:0;font-size:.75rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:hsl(var(--muted-foreground))}.keyboard{display:grid;place-items:center;gap:.35rem;padding:1.25rem 0 .5rem}.keyboard div{display:flex;gap:.35rem}.keyboard kbd{display:grid;place-items:center;width:2.7rem;height:2.5rem;border:1px solid hsl(var(--brand));border-bottom-width:3px;border-radius:.4rem;background:hsl(var(--brand)/.1);font:700 .9rem system-ui;color:hsl(var(--foreground))}.keyboard .wide{width:8.7rem;font-size:.75rem}.mobile-card>p:last-child{margin:.8rem 0 0;text-align:center;font-size:.9rem;color:hsl(var(--muted-foreground))}.phone{position:relative;width:7rem;height:10.5rem;margin:1rem auto 0;border:6px solid hsl(var(--foreground));border-radius:1.3rem;overflow:hidden;background:linear-gradient(#b9d4e1 0 44%,#81a66d 45%)}.road{position:absolute;bottom:-2rem;left:1.8rem;width:3.5rem;height:8rem;background:#bd855d;transform:rotate(18deg)}.car{position:absolute;bottom:2.3rem;left:2.7rem;width:1.6rem;height:2.4rem;border:2px solid hsl(var(--foreground));border-radius:.4rem;background:#f7f3eb}.finger{position:absolute;right:.4rem;bottom:1.4rem;font-size:1.65rem;transform:rotate(-25deg)}@media(max-width:640px){.control-guide{grid-template-columns:1fr}}
</style>
