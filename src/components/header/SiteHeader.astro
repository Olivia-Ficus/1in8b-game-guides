---
/**
 * Site header — logo, primary nav, theme toggle, language switcher.
 * Mobile menu uses native <details> (zero JS).
 */
import { Icon } from 'astro-icon/components';
import { site } from '~/config/site';
import { type Locale, defaultLocale, locales, LOCALE_LABELS } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { homeUrl, localizePath, gamesPath } from '~/lib/url';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import SearchButton from './SearchButton.astro';

interface Props {
  locale: Locale;
  currentPath: string;
  /**
   * Locales the current page exists in (optional). Pages that DON'T fall
   * back to English (tag pages) pass their real coverage so the language
   * switcher never links to a 404.
   */
  availableLocales?: readonly Locale[];
}
const { locale, currentPath, availableLocales } = Astro.props;
const ui = getUi(locale);
const nav: Record<string, string> = ui.nav as Record<string, string>;

const headerLocales = availableLocales ?? locales;
const gamesHref = gamesPath(locale);
const gamesActive = currentPath === gamesHref || currentPath.startsWith(`${gamesHref}`);
const aboutHref = localizePath('/about', locale);

// Build the strip regex from `locales` — a hardcoded "en|ja" list would
// silently break for forks that add languages (same rationale as BaseLayout).
const localePrefixRe = new RegExp(
  `^/(${locales.filter((l) => l !== defaultLocale).join('|')})(?=/|$)`,
);

const samePagePathFor = (loc: Locale) => {
  // Strip existing locale prefix, then prepend the new one. Homepages go
  // through homeUrl so the default locale remains rooted at '/'.
  const stripped = currentPath.replace(localePrefixRe, '') || '/';
  const isHome = stripped === '/';
  return isHome ? homeUrl(loc) : localizePath(stripped, loc);
};
---

<header class="sticky top-0 z-40 w-full bg-background/95">
  <div
    class="mx-auto flex min-h-16 max-w-7xl items-center gap-5 border-b-2 border-foreground px-4 py-2"
  >
    {/* Logo */}
    <a
      href={homeUrl(locale)}
      class="flex shrink-0 items-baseline gap-2 text-foreground"
      aria-label={site.name}
    >
      <span class="archive-display text-2xl leading-none">{site.shortName}</span>
      <span
        class="hidden border-l border-border pl-2 text-[10px] font-extrabold uppercase tracking-[0.16em] text-muted-foreground sm:inline"
        >Game Guides</span
      >
    </a>

    {/* Desktop nav */}
    <nav class="hidden items-center gap-6 md:flex">
      <a
        href={gamesHref}
        class:list={[
          'border-b-2 py-2 text-sm font-bold transition',
          gamesActive
            ? 'border-nav text-nav'
            : 'border-transparent text-foreground/80 hover:border-foreground',
        ]}>Games</a
      >
      <a
        href={aboutHref}
        class="border-b-2 border-transparent py-2 text-sm font-bold text-foreground/80 transition hover:border-foreground"
        >About</a
      >
    </nav>

    {/* Right actions */}
    <div class="ml-auto flex min-w-0 items-center gap-1">
      <SearchButton locale={locale} variant="field" labels={{ placeholder: 'Search games...' }} />
      <ThemeToggle />
      <LanguageSwitcher
        locale={locale}
        pathFor={samePagePathFor}
        availableLocales={availableLocales}
      />

      {/* Mobile menu */}
      <details class="relative md:hidden">
        <summary
          class="inline-flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-sm border border-transparent text-foreground transition hover:border-border hover:bg-muted"
        >
          <Icon name="lucide:menu" class="h-5 w-5" />
        </summary>
        <div class="absolute right-0 mt-2 w-56 overflow-hidden rounded-sm border bg-card">
          {/* Prominent search entry — mobile readers don't know Cmd+K */}
          <button
            type="button"
            data-open-search
            class="flex w-full items-center gap-2 border-b border-border px-3 py-2.5 text-sm font-medium text-nav transition hover:bg-muted"
          >
            <Icon name="lucide:search" class="h-4 w-4" />
            <span>{nav.search ?? 'Search'}</span>
          </button>
          <a href={gamesHref} class="block px-3 py-2 text-sm transition hover:bg-muted">Games</a>
          <a href={aboutHref} class="block px-3 py-2 text-sm transition hover:bg-muted">About</a>
          {/* Language switcher for mobile — flat list, not nested dropdown */}
          <div class="border-t border-border pt-1">
            <div class="flex items-center gap-1 px-3 pb-1 text-xs text-muted-foreground">
              <Icon name="lucide:globe" class="h-3 w-3" />
              <span>{nav.language ?? 'Language'}</span>
            </div>
            {
              headerLocales.map((loc) => (
                <a
                  href={samePagePathFor(loc)}
                  class:list={[
                    'block px-3 py-2 text-sm transition hover:bg-muted',
                    loc === locale && 'font-semibold text-nav',
                  ]}
                >
                  {LOCALE_LABELS[loc]}
                </a>
              ))
            }
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
