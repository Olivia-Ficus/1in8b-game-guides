---
/**
 * Global 404 page.
 * Rendered with default locale (English) since 404s have no locale context.
 *
 * v1.5: recovery-first design — the Pagefind search dialog (lazy-loaded,
 * zero JS until open) plus category entry points convert a lost visit into
 * a search or a browse instead of a bounce.
 */
import BaseLayout from '~/components/layout/BaseLayout.astro';
import SearchButton from '~/components/header/SearchButton.astro';
import { Icon } from 'astro-icon/components';
import { defaultLocale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { gamesPath, homeUrl } from '~/lib/url';

const ui = getUi(defaultLocale);
const nav = ui.nav as Record<string, string>;
const shared = ui.shared;
---

<BaseLayout
  locale={defaultLocale}
  title={shared.notFoundTitle}
  description={shared.notFoundDescription}
  noindex
>
  <div
    class="mx-auto flex min-h-screen max-w-lg flex-col items-center justify-center px-4 text-center"
  >
    <Icon name="lucide:compass" class="h-16 w-16 text-nav" />
    <h1 class="mt-6 text-6xl font-extrabold">404</h1>
    <p class="mt-2 text-lg font-semibold">{shared.notFoundHeading}</p>
    <p class="mt-1 text-sm text-muted-foreground">
      {shared.notFoundText}
    </p>

    <div class="mt-6 flex items-center gap-3">
      <div class="inline-flex items-center rounded-md border border-border bg-card">
        <span class="pl-3 text-sm text-muted-foreground" aria-hidden="true">
          <Icon name="lucide:search" class="h-4 w-4" />
        </span>
        <SearchButton locale={defaultLocale} />
      </div>
      <a href={homeUrl(defaultLocale)} class="btn-primary">
        <Icon name="lucide:home" class="mr-2 h-4 w-4" />
        {shared.notFoundBackHome}
      </a>
    </div>
    <p class="mt-3 text-xs text-muted-foreground">{shared.notFoundSearchHint}</p>

    <div class="mt-10 w-full">
      <a href={gamesPath(defaultLocale)} class="btn-primary inline-flex items-center gap-2">
        <Icon name="lucide:gamepad-2" class="h-4 w-4" />
        Browse Games
      </a>
    </div>
  </div>
</BaseLayout>
