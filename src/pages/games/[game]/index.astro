---
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import DirtBoundSinglePage from '~/components/games/dirtbound/DirtBoundSinglePage.astro';
import { defaultLocale } from '~/i18n/routing';
import { getPublishedGames, getGameGuides } from '~/lib/games';
import { gameGuidePath, gamesPath, homeUrl } from '~/lib/url';
import { gameBreadcrumbJsonLd, gameJsonLd } from '~/lib/seo';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  return (await getPublishedGames()).map((game) => ({
    params: { game: game.data.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const guides = await getGameGuides(game.data.slug, defaultLocale);
const typeLabel = (type: string) =>
  type.replace(/-/g, ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
const faqJsonLd = game.data.faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: game.data.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;
const jsonLd = [
  gameJsonLd(game.data, defaultLocale),
  gameBreadcrumbJsonLd(game.data, undefined, undefined, defaultLocale),
  ...(faqJsonLd ? [faqJsonLd] : []),
];
---

<LocaleLayout
  locale={defaultLocale}
  title={game.data.name}
  description={game.data.description}
  noindex={game.data.noindex}
  jsonLd={jsonLd}
>
  {
    game.data.presentation === 'single-page' ? (
      <DirtBoundSinglePage game={game} />
    ) : (
      <>
        <nav class="text-sm text-muted-foreground">
          <>
            <a href={homeUrl(defaultLocale)}>Home</a>
            <span class="mx-1">/</span>
            <a href={gamesPath(defaultLocale)}>Games</a>
            <span class="mx-1">/</span>
            <span>{game.data.name}</span>
          </>
        </nav>
        <section class="game-hero mt-6 overflow-hidden rounded-sm border">
          <>
            <div class="p-6 md:p-10">
              <>
                <p class="archive-kicker">Game guide</p>
                <h1 class="mt-2 text-4xl font-black tracking-tight md:text-6xl">
                  {game.data.name}
                </h1>
                <p class="mt-4 max-w-2xl text-lg text-muted-foreground">{game.data.description}</p>
                <div class="mt-6 flex flex-wrap gap-3">
                  {game.data.officialUrl && (
                    <a
                      href={game.data.officialUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-primary"
                    >
                      Play Game <Icon name="lucide:external-link" class="ml-2 h-4 w-4" />
                    </a>
                  )}
                  {guides.length > 0 && (
                    <a href="#player-help" class="btn-outline">
                      Guides &amp; Tips
                    </a>
                  )}
                </div>
                <p class="mt-5 text-xs text-muted-foreground">
                  Independent player companion. Official links are shown only when configured and
                  verified.
                </p>
              </>
            </div>
            <aside class="game-sidebar border-t bg-muted/40 md:border-l md:border-t-0">
              {game.data.cover && (
                <img
                  src={game.data.cover}
                  alt={`${game.data.name} gameplay`}
                  class="game-cover"
                  loading="eager"
                />
              )}
              <div class="p-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                  At a glance
                </p>
                {game.data.platforms.length > 0 && (
                  <p class="mt-3 flex gap-2 text-sm">
                    <Icon name="lucide:gamepad-2" class="h-4 w-4 text-nav" />
                    {game.data.platforms.join(' · ')}
                  </p>
                )}
                {game.data.genre && (
                  <p class="mt-3 flex gap-2 text-sm">
                    <Icon name="lucide:layers-3" class="h-4 w-4 text-nav" />
                    {game.data.genre}
                  </p>
                )}
                <p class="mt-3 flex gap-2 text-sm">
                  <Icon name="lucide:clock-3" class="h-4 w-4 text-nav" />
                  Updated{' '}
                  {game.data.updatedAt.toLocaleDateString(defaultLocale, { timeZone: 'UTC' })}
                </p>
              </div>
            </aside>
          </>
        </section>
        {guides.length > 0 && (
          <section id="player-help" class="mt-12">
            <p class="archive-kicker">Player help</p>
            <h2 class="mt-1 text-2xl font-black">Guides &amp; Tips</h2>
            <p class="mt-2 max-w-2xl text-muted-foreground">
              Choose the task you are trying to complete; each guide stays scoped to{' '}
              {game.data.name}.
            </p>
            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              {guides.map((guide) => (
                <a
                  class="task-card block p-5"
                  href={gameGuidePath(game.data.slug, guide.data.topic, defaultLocale)}
                >
                  <p class="text-xs font-semibold uppercase tracking-wider text-nav">
                    {typeLabel(guide.data.type)}
                  </p>
                  <h3 class="mt-2 font-bold">{guide.data.title}</h3>
                  <p class="mt-2 text-sm text-muted-foreground">{guide.data.description}</p>
                  <p class="mt-4 text-sm font-semibold">
                    Open guide <span aria-hidden="true">→</span>
                  </p>
                </a>
              ))}
            </div>
          </section>
        )}
      </>
    )
  }
</LocaleLayout>

<style>
  .game-hero {
    display: grid;
    grid-template-columns: 1fr;
    background: hsl(var(--card));
  }
  .game-cover {
    display: block;
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
  }
  .task-card {
    border: 1px solid hsl(var(--border));
    border-radius: 2px;
    background: hsl(var(--card));
    transition: border-color 0.18s ease;
  }
  .task-card:hover {
    border-color: hsl(var(--brand));
  }
  @media (min-width: 768px) {
    .game-hero {
      grid-template-columns: 1fr 22rem;
    }
    .game-sidebar {
      display: flex;
      flex-direction: column;
    }
    .game-sidebar > div {
      margin-top: auto;
    }
  }
</style>
