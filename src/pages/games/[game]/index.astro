---
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import { defaultLocale } from '~/i18n/routing';
import { getPublishedGames, getGameGuides } from '~/lib/games';
import { gameGuidePath, gamesPath, homeUrl } from '~/lib/url';
import { gameBreadcrumbJsonLd, gameJsonLd } from '~/lib/seo';
import { Icon } from 'astro-icon/components';
export async function getStaticPaths() {
  return (await getPublishedGames()).map((game) => ({ params: { game: game.data.slug }, props: { game } }));
}
const { game } = Astro.props;
const guides = await getGameGuides(game.data.slug, defaultLocale);
---
<LocaleLayout locale={defaultLocale} title={game.data.name} description={game.data.description} noindex={game.data.noindex} jsonLd={[gameJsonLd(game.data, defaultLocale), gameBreadcrumbJsonLd(game.data, undefined, undefined, defaultLocale)]}>
  <nav class="text-sm text-muted-foreground"><a href={homeUrl(defaultLocale)}>Home</a><span class="mx-1">/</span><a href={gamesPath(defaultLocale)}>Games</a><span class="mx-1">/</span><span>{game.data.name}</span></nav>
  <section class="game-hero mt-4 overflow-hidden rounded-2xl border"><div class="p-6 md:p-10"><p class="text-sm font-semibold text-nav">Game navigation</p><h1 class="mt-2 text-4xl font-black tracking-tight md:text-5xl">{game.data.name}</h1><p class="mt-4 max-w-2xl text-lg text-muted-foreground">{game.data.description}</p><div class="mt-6 flex flex-wrap gap-3">{game.data.officialUrl && <a href={game.data.officialUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">Play Game <Icon name="lucide:external-link" class="ml-2 h-4 w-4" /></a>}<a href="#player-help" class="btn-outline">Browse player help</a></div><p class="mt-5 text-xs text-muted-foreground">Independent player companion. Official links are shown only when configured and verified.</p></div><aside class="border-t bg-muted/40 p-5 md:border-l md:border-t-0"><p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">At a glance</p>{game.data.platforms.length > 0 && <p class="mt-3 flex gap-2 text-sm"><Icon name="lucide:gamepad-2" class="h-4 w-4 text-nav" />{game.data.platforms.join(' · ')}</p>}{game.data.genre && <p class="mt-3 flex gap-2 text-sm"><Icon name="lucide:layers-3" class="h-4 w-4 text-nav" />{game.data.genre}</p>}<p class="mt-3 flex gap-2 text-sm"><Icon name="lucide:clock-3" class="h-4 w-4 text-nav" />Updated {game.data.updatedAt.toLocaleDateString(defaultLocale, { timeZone: 'UTC' })}</p></aside></section>
  {guides.length > 0 && <section id="player-help" class="mt-12"><p class="text-sm font-semibold text-nav">Player help</p><h2 class="mt-1 text-2xl font-black">What do you need?</h2><div class="mt-5 grid gap-4 sm:grid-cols-2">{guides.map((guide) => <a class="task-card block p-5" href={gameGuidePath(game.data.slug, guide.data.topic, defaultLocale)}><p class="text-xs font-semibold uppercase tracking-wider text-nav">{guide.data.type}</p><h3 class="mt-2 font-bold">{guide.data.title}</h3><p class="mt-2 text-sm text-muted-foreground">{guide.data.description}</p><p class="mt-4 text-sm font-semibold">Open guide <span aria-hidden="true">→</span></p></a>)}</div></section>}
</LocaleLayout>
<style>.game-hero{display:grid;grid-template-columns:1fr;background:linear-gradient(135deg,hsl(var(--brand) / .14),transparent 60%),hsl(var(--card))}@media(min-width:768px){.game-hero{grid-template-columns:1fr 16rem}}.task-card{border:1px solid hsl(var(--border));border-radius:.85rem;background:hsl(var(--card));transition:border-color .18s ease,transform .18s ease}.task-card:hover{border-color:hsl(var(--brand));transform:translateY(-2px)}</style>
