---
/**
 * Root index — handles the default-locale (English) homepage.
 *
 * With `prefixDefaultLocale: false`, the root URL `/` maps directly to the
 * English homepage. Non-default locales use the `[locale]` route.
 */
import PortalHome from '~/components/game/PortalHome.astro';
import { defaultLocale } from '~/i18n/routing';

const locale = defaultLocale;

---

<PortalHome locale={locale} />
